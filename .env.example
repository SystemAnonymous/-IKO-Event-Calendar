# Get this from https://discord.com/developers/applications -> your app -> Bot -> Token
DISCORD_TOKEN=your-bot-token-here

# Timezone used when you type dates/times into /create_event.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/New_York

# Where to store the SQLite database. Leave as-is for local dev.
# On Railway, set this to a path inside a mounted Volume, e.g. /data/events.db,
# so data survives redeploys.
DB_PATH=events.db
